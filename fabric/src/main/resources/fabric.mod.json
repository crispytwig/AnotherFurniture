{
  "schemaVersion": 1,
  "id": "another_furniture",
  "version": "${version}",
  "name": "Another Furniture",
  "description": "Decorating your home just got better! Another Furniture adds various furniture, with the goal of staying vanilla-styled and consistently sized, keeping normal blocks and player sizes in mind.",
  "authors": [
    "Starfish Studios",
	"Crispytwig",
	"Synthestra"
  ],
  "contributors": [
	"TheFusion21 (Thank you for the 26.2 port!)"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/another-furniture",
    "issues": "https://github.com/starfish-studios/AnotherFurniture/issues"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.starfish_studios.another_furniture.fabric.AnotherFurnitureFabric"
    ],
    "client": [
      "com.starfish_studios.another_furniture.fabric.AnotherFurnitureFabricClient"
    ]
  },
  "mixins": [
    "another_furniture.mixins.json",
	"another_furniture.common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
